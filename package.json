{
  "name": "@epistery/client-lib",
  "version": "1.1.1",
  "description": "Shared browser modules for epistery plugin UIs — cipher (the browser twin of @epistery/sessions bot-identity), the MarkUp wiki renderer, and pure WikiWord extraction. The shell serves these at /lib/*; plugin client bundles import them by that URL.",
  "type": "module",
  "main": "wikiwords.mjs",
  "exports": {
    "./cipher": "./cipher.mjs",
    "./markup": "./markup.mjs",
    "./wikiwords": "./wikiwords.mjs",
    "./componentry": "./componentry.mjs",
    "./IdForge": "./IdForge.mjs",
    "./Toast": "./Toast.mjs",
    "./Popup": "./Popup.mjs",
    "./component-acl": "./component-acl.mjs",
    "./pool": "./pool.mjs",
    "./treekem": "./treekem.mjs",
    "./treekem-kdf": "./treekem-kdf.mjs",
    "./ds-group": "./ds-group.mjs",
    "./sealed": "./sealed.mjs",
    "./adslot": "./adslot.mjs",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cipher.mjs",
    "markup.mjs",
    "wikiwords.mjs",
    "componentry.mjs",
    "IdForge.mjs",
    "Toast.mjs",
    "Popup.mjs",
    "component-acl.mjs",
    "pool.mjs",
    "treekem.mjs",
    "treekem-kdf.mjs",
    "ds-group.mjs",
    "sealed.mjs",
    "adslot.mjs",
    "components/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epistery/client-lib.git"
  },
  "license": "MIT",
  "author": "Rootz Corp"
}
